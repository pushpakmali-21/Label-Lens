# ── Gemini API ───────────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database ─────────────────────────────────────────────────────────────────────
# Prototype: SQLite (no setup required)
DATABASE_URL=sqlite:///./labellens.db
# Production: swap to Postgres
# DATABASE_URL=postgresql+asyncpg://labellens:labellens_dev@localhost:5432/labellens

# ── Security ─────────────────────────────────────────────────────────────────────
# Change this to a strong random secret in any non-local environment
SECRET_KEY=labellens-dev-secret-key-change-me-in-production

# ── App ──────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=0.1.0

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
