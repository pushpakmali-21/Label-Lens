# ── Database ─────────────────────────────────────────────────────────────────────
# For local development outside Docker, use localhost:5432
# Docker Compose overrides this with the internal container hostname
DATABASE_URL=postgresql+asyncpg://labellens:labellens_dev@localhost:5432/labellens

# ── Redis ────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────────────────────────
# Change this to a strong random secret in any non-local environment
SECRET_KEY=labellens-dev-secret-key-change-me-in-production

# ── App ──────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=0.1.0

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
